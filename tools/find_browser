#!/usr/bin/env bash
# Prints a usable Chrome/Chromium binary for Remotion (its own download host is blocked here).
for c in "$REMOTION_BROWSER" \
  /opt/pw-browsers/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell \
  /opt/pw-browsers/chromium \
  "$(command -v chromium 2>/dev/null)" "$(command -v chromium-browser 2>/dev/null)" "$(command -v google-chrome 2>/dev/null)"; do
  [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; exit 0; }
done
echo "no browser found" >&2; exit 1
