 "lines": [
  {
   "start": 0.0,
   "end": 2.68,
   "text": "श्कूटर वाली पहली का जवाब एक हजार नहीं?"
  },
  {
   "start": 2.78,
   "end": 3.88,
   "text": "पूरे थो हजार"
  },
  {
   "start": 3.88,
   "end": 6.16,
   "text": "देखो, पप्पूने कुल कितने पैसे दिये?"
  },
  {
   "start": 6.28,
   "end": 7.78,
   "text": "8,000 और 10,000"
  },
  {
   "start": 7.78,
   "end": 9.24,
   "text": "यानी 18,000"
  },
  {
   "start": 9.24,
   "end": 10.24,
   "text": "और उसे कितने मिले?"
  },
  {
   "start": 10.32,
   "end": 11.18,
   "text": "9,000"
  },
  {
   "start": 11.18,
   "end": 12.26,
   "text": "और 11,000"
  },
  {
   "start": 12.26,
   "end": 13.36,
   "text": "यानी 20,000"
  },
  {
   "start": 13.36,
   "end": 16.8,
   "text": "बीस में से 18 गय तो फप्यदा पूरे 2,000"
  },
  {
   "start": 16.8,
   "end": 17.38,
   "text": "पर रुको!"
  },
  {
   "start": 17.38,
   "end": 20.3,
   "text": "अपस खरीदने में एक हजार का नुक्सान नहीं हूँ?"
  },
  {
   "start": 20.44,
   "end": 24.22,
   "text": "नहीं, वो दस हजार हम पहले ही करचे में गिन चुके हैं"
  },
  {
   "start": 24.22,
   "end": 28.44,
   "text": "आसान तरीका, तो अलक सोदे और दोनो में एक एक हजार का फ़ाईदा"
  },
  {
   "start": 28.44,
   "end": 30.38,
   "text": "अगली रील में इस से भी तेडी पहली"
  },
  {
   "start": 30.47,
   "end": 31.81,
   "text": "यो, अदर बादिया था।"
  },
  {
   "start": 32.47,
   "end": 34.67,
   "text": "और अजी पहेलियों के लिए फोलो करो"
  },
  {
   "start": 34.67,
   "end": 35.73,
   "text": "देली रिटल्स 12"
  }
 ],
 "source": "whisper-small"
}