 "lines": [
  {
   "start": 0.0,
   "end": 2.7,
   "text": "पप्पू मेले पूँजगगया, वो भी काका की मदधच से"
  },
  {
   "start": 2.7,
   "end": 4.18,
   "text": "सही जवाब भी"
  },
  {
   "start": 4.18,
   "end": 6.92,
   "text": "काका की अंदर जाते ही, पप्पूब पूबब़ चल पडा"
  },
  {
   "start": 6.92,
   "end": 10.22,
   "text": "चार मिनद पचास सेकंट तक वो मेले की तरफ चलता रहा"
  },
  {
   "start": 10.22,
   "end": 14.32,
   "text": "फिर थीक पाच मिन्नट से पहले वो पल्टा और काका की तरफ चलने लगा"
  },
  {
   "start": 14.32,
   "end": 17.62,
   "text": "काका बहार आए और देखा कोई उनकी तरफ आए आए है"
  },
  {
   "start": 17.62,
   "end": 21.54,
   "text": "उने लगा ये मेले से आया है तो वापस मेले की तरफ बहेज दिया"
  },
  {
   "start": 21.54,
   "end": 24.24,
   "text": "बचा था बस तीन मिनट भीस सेकंट का रास्ता"
  },
  {
   "start": 24.24,
   "end": 26.92,
   "text": "और अगली जाएक से पहले पप्पू मेले में"
  },
  {
   "start": 26.92,
   "end": 28.4,
   "text": "अगली रील में नहीं पहली"
  },
  {
   "start": 28.4,
   "end": 29.28,
   "text": "सहीं बताया था"
  },
  {
   "start": 29.28,
   "end": 29.96,
   "text": "कमेंट करो"
  },
  {
   "start": 29.96,
   "end": 32.1,
   "text": "और अजी पहलीों के लिए फोलो करो"
  },
  {
   "start": 32.1,
   "end": 33.18,
   "text": "देली रिटल्स 12"
  }
 ],
 "source": "whisper-small"
}