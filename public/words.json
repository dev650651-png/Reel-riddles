 "lines": [
  {
   "start": 0.0,
   "end": 1.56,
   "text": "एक स्कूतर चार सोदे"
  },
  {
   "start": 1.56,
   "end": 3.58,
   "text": "बताओ पप्हू को कितना फ़दा हूह"
  },
  {
   "start": 3.58,
   "end": 4.9,
   "text": "सनदे बाजार में"
  },
  {
   "start": 4.9,
   "end": 6.74,
   "text": "पप्हू ले एक पुराना स्कूतर कहरीदा"
  },
  {
   "start": 6.74,
   "end": 8.14,
   "text": "आप हदार रुपैं में"
  },
  {
   "start": 8.14,
   "end": 9.3,
   "text": "फिर उसने वही स्कूतर"
  },
  {
   "start": 9.3,
   "end": 11.52,
   "text": "गोलु भीया को बेच्टिया नुाधार में"
  },
  {
   "start": 11.52,
   "end": 12.16,
   "text": "अगले हफ्टे"
  },
  {
   "start": 12.16,
   "end": 15.18,
   "text": "पप्पू ने उसे वापस कहीड लिया दस हजार में"
  },
  {
   "start": 15.18,
   "end": 17.2,
   "text": "और आखर में उसे फिर से बेज दिया"
  },
  {
   "start": 17.2,
   "end": 18.48,
   "text": "गयारा हजार रुपै में"
  },
  {
   "start": 18.48,
   "end": 21.2,
   "text": "अब सोचो पप्पू को कुल कितना फ़दा हूँँँँ"
  },
  {
   "start": 21.2,
   "end": 22.28,
   "text": "आए एक हजार"
  },
  {
   "start": 22.28,
   "end": 23.98,
   "text": "बी कुछ नहीं सब बराबर"
  },
  {
   "start": 23.98,
   "end": 25.04,
   "text": "C, 2000"
  },
  {
   "start": 25.04,
   "end": 26.24,
   "text": "D, 3000"
  },
  {
   "start": 26.24,
   "end": 27.5,
   "text": "दियान से सोचना"
  },
  {
   "start": 27.5,
   "end": 29.52,
   "text": "जब आद़द लोग यही पहसते हैं"
  },
  {
   "start": 29.52,
   "end": 30.8,
   "text": "अपना जवाब कोमट में लिखो"
  },
  {
   "start": 30.8,
   "end": 31.86,
   "text": "सही जवाब"
  },
  {
   "start": 31.86,
   "end": 34.24,
   "text": "अगी रील में आजी और पहलीों के लिए"
  },
  {
   "start": 34.24,
   "end": 35.98,
   "text": "फोलो करो देली रिडल्स 12"
  }
 ],
 "source": "whisper-small"
}