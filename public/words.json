 "lines": [
  {
   "start": 0.0,
   "end": 2.74,
   "text": "8 मिनٹ का पूल, हर 5 मिन्त चोकिदार"
  },
  {
   "start": 2.74,
   "end": 4.3,
   "text": "पप्पू मेले पहुचेगा कैसे?"
  },
  {
   "start": 4.5,
   "end": 6.68,
   "text": "नदीपार मेला है, पर पूल बन्ध है"
  },
  {
   "start": 6.68,
   "end": 8.8,
   "text": "पूल पार करने में 8 मिन्ट लगते हैं"
  },
  {
   "start": 8.8,
   "end": 10.2,
   "text": "किनारे पर रामलाल काका"
  },
  {
   "start": 10.2,
   "end": 12.4,
   "text": "हर 5 मिन्ट में बाहर जागते हैं"
  },
  {
   "start": 12.4,
   "end": 15.94,
   "text": "पूल पर जो दिखे वो जिदर से आया उदर वापस बेज देते हैं"
  },
  {
   "start": 15.94,
   "end": 17.68,
   "text": "बागा तो पूल चर मराएगा"
  },
  {
   "start": 17.68,
   "end": 20.14,
   "text": "चुपने की जगा नहीं तो पप्पू क्या करे?"
  },
  {
   "start": 20.34,
   "end": 22.08,
   "text": "आई, काका के अंदर जाते ही चलो"
  },
  {
   "start": 22.08,
   "end": 25.52,
   "text": "दी, पाच मिनट्ट से टीक पहले पलड़कर काका की तरफ चलो"
  },
  {
   "start": 25.52,
   "end": 27.6,
   "text": "थी, पाच मिन्ट चलो फिर लोतो"
  },
  {
   "start": 27.6,
   "end": 29.38,
   "text": "थी, पूरी ताकत से बागो"
  },
  {
   "start": 29.38,
   "end": 31.46,
   "text": "सोचकर जबाब कोमिट में लिखो"
  },
  {
   "start": 31.46,
   "end": 33.36,
   "text": "सही जबाब अगली रील में"
  },
  {
   "start": 33.36,
   "end": 35.0,
   "text": "फोलो करो देली रिडल्स 12"
  }
 ],
 "source": "whisper-small"
}